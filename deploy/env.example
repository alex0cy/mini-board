# Копия -> /opt/mini-board/env, chmod 600. В git не коммитить.
MINIBOARD_IMAGE=mini-board:REPLACED_BY_REDEPLOY
MINIBOARD_BASE_URL=https://board.example.com
MINIBOARD_REPO_URL=https://github.com/OWNER/mini-board
# Соль для хэша отпечатка. Сгенерировать: openssl rand -hex 16
MINIBOARD_SALT=CHANGE_ME
MINIBOARD_MAX_BODY=8000
MINIBOARD_RATE_PER_HOUR=60
MINIBOARD_GH_REPO=OWNER/mini-board
MINIBOARD_GH_TOKEN_FILE=/opt/mini-board/gh-token
